# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_BROWSER_SAFE_SUPABASE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_OR_SECRET_KEY

# CCB / Pushpay ChMS API
CCB_API_URL=https://heritagelife.ccbchurch.com/api.php
CCB_API_USERNAME=YOUR_CCB_API_USERNAME
CCB_API_PASSWORD=YOUR_CCB_API_PASSWORD

# App URL
APP_BASE_URL=http://localhost:3000

# Optional helper for controlled first-admin setup docs.
ADMIN_BOOTSTRAP_EMAIL=you@example.com

# Public endpoint protection
PUBLIC_RATE_LIMIT_WINDOW_SECONDS=60
PUBLIC_RATE_LIMIT_MAX_ATTEMPTS=20

# All supported non-destructive CCB writes are enabled in this build.
# CCB delete/remove/inactivate services are blocked in code and cannot be called.
